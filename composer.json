{
    "name": "edulazaro/wirecookies",
    "description": "Drop-in cookie consent banner + preferences modal for Laravel apps. Themeable through the wire* family CSS variables — shares look with wiremodal and wiretoast.",
    "type": "library",
    "keywords": ["laravel", "cookies", "consent", "rgpd", "gdpr", "blade", "alpine"],
    "license": "MIT",
    "authors": [
        {
            "name": "Edu Lazaro",
            "email": "eduzro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "edulazaro/wiremodal": "^1.1",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "EduLazaro\\WireCookies\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduLazaro\\WireCookies\\WireCookiesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
